        "url": "https://quickchart.io/chart",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const d = $('Build report data').first().json; const h = d.health; const c = d.counts; const rag = String(h.rag_status || ''); const color = rag === 'Green' ? '#2e7d32' : (rag === 'Red' ? '#c62828' : '#f9a825'); return JSON.stringify({ width: 1200, height: 675, format: 'png', backgroundColor: 'white', chart: { type: 'horizontalBar', data: { labels: ['Overdue tasks', 'Critical overdue', 'Max days overdue', 'Actions logged', 'Actions without owner', 'Risks', 'Issues', 'High severity items'], datasets: [{ label: 'Count', backgroundColor: ['#1f4e79', '#1f4e79', '#1f4e79', '#5b7a99', '#5b7a99', '#7f8c8d', '#7f8c8d', '#7f8c8d'], data: [h.overdue_tasks, h.critical_overdue_tasks, h.max_days_overdue, c.actions_total, c.actions_without_owner, c.risks, c.issues, c.high_severity_items].map(Number) }] }, options: { legend: { display: false }, title: { display: true, fontSize: 20, fontColor: color, text: ['BrightMart CRM Rollout - Weekly Status', 'Report date ' + h.report_date + '   |   RAG status: ' + rag, 'Actual complete ' + h.actual_complete + '   |   Planned complete ' + h.planned_complete + '   |   Schedule variance ' + h.schedule_variance] }, plugins: { datalabels: { anchor: 'end', align: 'right', color: '#1f2d3d', font: { size: 16, weight: 'bold' } } }, scales: { xAxes: [{ ticks: { beginAtZero: true } }] }, layout: { padding: { right: 40, bottom: 10 } } } } }); })() }}",
